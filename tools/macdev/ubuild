#!/bin/bash
# ubuild OUTDIR [TARGET...]   compile userland programs on this Mac in the kernel-builder container (aarch64 Linux: cross clang + ld64 + the iPhoneOS 16.5 SDK)
#   UBUILD_WS=hk-ws: the volume to take xnu-deps from (default hk-ws-cam)
#   TARGET: net_test, media (libhackios-media.dylib: inject_media.c camera_device.c camera_isp.c), camera_test, camera_avtest, torch_test, record_test, vt_test, sb (libhackios-sb.dylib: inject_sb.c), ui (libhackios-ui.dylib: inject_ui.c)   (default: media camera_test)
#   Streams userland/src in (the repo share is slow under Docker, never bind-mount it); uses the xnu-deps/host/bin tools and the iPhoneOS16.5 SDK from the volumes
#   hk-ws-cam (read-only) and theos. The command lines are build.sh's $DYN ones. The `media' result of an unchanged tree is byte-identical to userland/obj's.
# This builds the programs only: put them into an image by repacking it (7z x -o DIR root.apfs; copy over DIR/hackios/bin or lib; tools/apfs/mkapfs.py -z --plain fw -o NEW.apfs hackios=DIR).
set -e
cd "$(dirname "$(readlink -f "$0")")/../.."
. tools/macdev/env.sh
out=$1; shift
[ -n "$out" ] || { sed -n 2,6p "$0"; exit 1; }
mkdir -p "$out"; out=$(cd "$out" && pwd)
targets=${*:-media camera_test}
cat > /tmp/ubuild-inner.sh <<'IN'
#!/bin/bash
set -e
mkdir -p /b && tar -xf - -C /b && cd /b/userland && mkdir -p obj
export THEOS=/opt/theos HACKIOS_ROOT=/ws XNUDEPS=/ws/xnu-deps XNU_SDK_VERSION=16.5 XNU_CLANG_DIR=/usr/bin
export PATH=/ws/xnu-deps/host/bin:$PATH
DYN="xnu-clang -arch arm64 -isysroot /opt/theos/sdks/iPhoneOS16.5.sdk -O1"
for t in "$@"; do
	case $t in
	media) $DYN -O2 -dynamiclib -install_name /hackios/lib/libhackios-media.dylib -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework IOSurface -framework Metal -framework Foundation -lobjc -o obj/libhackios-media.dylib src/inject_media.c src/camera_device.c src/camera_isp.c src/camera_gpu.m src/m2scaler.c src/oslog_mirror.c src/h264_vt.c src/h264enc.c -framework Accelerate ;;
	inject) $DYN -dynamiclib -install_name /hackios/lib/libhackios.dylib -framework CoreFoundation -framework IOKit -lobjc -o obj/libhackios.dylib src/inject.c ;;
	sb) $DYN -dynamiclib -install_name /hackios/lib/libhackios-sb.dylib -framework CoreFoundation -framework CoreGraphics -framework IOKit -lobjc -o obj/libhackios-sb.dylib src/inject_sb.c ;;
	gl) M=/ws/xnu-deps/build/mesa/out; python3 mkeagl.py src/eagl_slots.txt $M/gl.xml $M/exported-gl.txt src/eagl.c > obj/eagl_gen.h; $DYN -dynamiclib -install_name /hackios/lib/libhackios-gl.dylib -Iobj -framework CoreFoundation -framework IOKit -framework IOSurface -lobjc $M/libOSMesa.8.dylib -o obj/libhackios-gl.dylib src/eagl.c src/gl_osmesa.c; rm -f obj/eagl_gen.h ;;
	phone) $DYN -O2 -dynamiclib -install_name /hackios/lib/libhackios-phone.dylib -lobjc -o obj/libhackios-phone.dylib src/inject_phone.c ;;
	call) $DYN -O2 -dynamiclib -install_name /hackios/lib/libhackios-call.dylib -framework CoreFoundation -lobjc -o obj/libhackios-call.dylib src/inject_call.c ;;
	ui) $DYN -O2 -dynamiclib -install_name /hackios/lib/libhackios-ui.dylib -lobjc -o obj/libhackios-ui.dylib src/inject_ui.c ;;
	cell) $DYN -O2 -o obj/hk_cell src/hk_cell.c ;;
	im) $DYN -O1 -fobjc-arc -dynamiclib -install_name /hackios/lib/libhackios-im.dylib -framework Foundation -lobjc -o obj/libhackios-im.dylib src/inject_im.m ;;
	commcenter) $DYN -O1 -fobjc-arc -framework Foundation -framework CallKit -lobjc -Wl,-sectcreate,__TEXT,__info_plist,src/hk_commcenter.info.plist -o obj/hk_commcenter src/hk_commcenter.m ;;  # (then, on the Mac: codesign -f -s - --entitlements userland/src/hk_commcenter.entitlements hk_commcenter: out/tree/flash.sh's callers do)
	smsd) $DYN -O2 -lsqlite3 -o obj/hk_smsd src/hk_smsd.c ;;
	net_test) $DYN -fobjc-arc -framework Foundation -framework SystemConfiguration -o obj/net_test src/net_test.m ;;
	time) $DYN -O2 -o obj/hk_time src/hk_time.c ;;
	sysctl) $DYN -O2 -o obj/hk_sysctl src/hk_sysctl.c ;;
	lun) $DYN -O2 -o obj/hk_lun src/hk_lun.c ;;
	metal) M="-framework Foundation -framework IOKit -framework Metal -lobjc"; $DYN -dynamiclib -install_name /hackios/lib/libhackiosmetal.dylib $M -o obj/libhackiosmetal.dylib src/hkmetal.m src/hkdrawable.m && $DYN -bundle $M -o obj/HKMetal src/hkmetal.m src/hkdrawable.m ;;
	cb_test) $DYN -O1 -fobjc-arc -framework Foundation -lobjc -o obj/cb_test src/cb_test.m ;;
	location) $DYN -O1 -fobjc-arc -framework Foundation -framework CoreLocation -lobjc -o obj/hk_location src/hk_location.m ;;
	objcdump) $DYN -O2 -lobjc -o obj/hk_objcdump src/hk_objcdump.c ;;
	logcfg) $DYN -O2 -o obj/hk_logcfg src/hk_logcfg.c ;;
	buddy) $DYN -O2 -framework CoreFoundation -o obj/hk_buddy src/hk_buddy.c ;;
	prefs) $DYN -O2 -framework CoreFoundation -o obj/hk_prefs src/hk_prefs.c ;;
	wifijoin) $DYN -O2 -framework CoreFoundation -o obj/hk_wifijoin src/hk_wifijoin.c ;;
	camera_test) $DYN -O2 -o obj/camera_test src/camera_test.c src/camera_isp.c ;;
	camera_avtest) $DYN -fobjc-arc -framework Foundation -framework AVFoundation -o obj/camera_avtest src/camera_avtest.m ;;
	torch_test) $DYN -framework CoreFoundation -framework AVFoundation -lobjc -o obj/torch_test src/torch_test.c ;;
	vt_test) $DYN -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework VideoToolbox -o obj/vt_test src/vt_test.c ;;
	record_test) $DYN -framework CoreFoundation -framework AVFoundation -lobjc -o obj/record_test src/record_test.c ;;
	*) echo "unknown target $t"; exit 1 ;;
	esac
done
cp obj/* /out/
IN
chmod +x /tmp/ubuild-inner.sh
COPYFILE_DISABLE=1 tar -cf - userland/src userland/mkeagl.py | docker run --rm -i -v ${UBUILD_WS:-hk-ws-cam}:/ws:ro -v theos:/opt/theos:ro -v /tmp/ubuild-inner.sh:/inner.sh:ro -v "$out":/out hackios-kernel-builder /inner.sh $targets
ls -l "$out"
